# ========================================================
# PTC Message & Security Discord Bot - Configuration
# ========================================================

# [REQUIRED] Discord Bot Token from Discord Developer Portal
# Go to https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# [RECOMMENDED] Server / Guild ID for instant Slash Command synchronization
GUILD_ID=123456789012345678

# [RECOMMENDED] Founder / Owner Discord User ID (Has override access to all commands)
FOUNDER_ID=123456789012345678

# [OPTIONAL] Specific Admin Role ID allowed to manage the bot
ADMIN_ROLE_ID=123456789012345678

# [RENDER / KEEP-ALIVE] HTTP Port for 24/7 UptimeRobot ping
PORT=8080

# [ANTI-SPAM SAFETY ENGINE SETTINGS]
# Delay between individual DMs in seconds (Humanized jitter)
DM_MIN_DELAY_SECONDS=3.0
DM_MAX_DELAY_SECONDS=6.0

# Batch size and cool-off breather pause
DM_BATCH_SIZE=20
DM_BATCH_PAUSE_SECONDS=25.0

# Max consecutive network/permission errors before auto-pausing campaign
MAX_CONSECUTIVE_ERRORS=5

